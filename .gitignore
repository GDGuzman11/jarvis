# =============================================================================
# Jarvis -- .gitignore
# =============================================================================

# --- Python ------------------------------------------------------------------
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
*.egg
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# uv.lock IS committed (reproducible installs) -- do not add it here

# --- Environment / Secrets ---------------------------------------------------
# NEVER commit a populated .env -- only .env.example is safe
.env
.env.local
.env.*.local
*.secret
*.key

# --- Databases and generated runtime data ------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/
workspace/

# --- Vector store / ML model artifacts ---------------------------------------
*.faiss
*.index
*.pkl
*.npy

# --- Audio / Media (generated at runtime) ------------------------------------
*.wav
*.mp3
*.ogg
*.flac
*.m4a

# --- Frontend ----------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
node_modules/
dist/

# --- Tauri / Rust ------------------------------------------------------------
frontend/src-tauri/target/
frontend/src-tauri/WixTools/
target/
*.rlib

# Cargo.lock is committed for binary projects (Tauri app) to ensure
# reproducible builds. Do not add Cargo.lock here.

# Installer artifacts (produced by tauri build)
*.exe
*.msi
*.deb
*.rpm
*.AppImage
*.dmg
*.app

# --- IDE / OS ----------------------------------------------------------------
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code local settings (machine-specific, not project config) ------
.claude/settings.local.json

# --- Logs --------------------------------------------------------------------
*.log
logs/

# --- Local design references (kept on disk, not tracked) ---------------------
References/

# --- ML / Binary artifacts (runtime-generated) -------------------------------
*.bin
*.meta.json
