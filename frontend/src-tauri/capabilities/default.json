{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all Jarvis HUD windows",
  "windows": ["animation", "reasoning", "communications", "agents", "tools"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "opener:default",
    "autostart:default"
  ]
}
