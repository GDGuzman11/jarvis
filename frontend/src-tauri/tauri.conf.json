{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "com.jarvis.hud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "animation",
        "title": "Jarvis — Animation",
        "url": "index.html?window=animation",
        "width": 360,
        "height": 360,
        "x": 40,
        "y": 60,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "reasoning",
        "title": "Jarvis — Reasoning",
        "url": "index.html?window=reasoning",
        "width": 520,
        "height": 720,
        "x": 440,
        "y": 60,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "communications",
        "title": "Jarvis — Communications",
        "url": "index.html?window=communications",
        "width": 720,
        "height": 480,
        "x": 980,
        "y": 60,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "agents",
        "title": "Jarvis — Agents",
        "url": "index.html?window=agents",
        "width": 760,
        "height": 560,
        "x": 440,
        "y": 560,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "tools",
        "title": "Jarvis — Tools",
        "url": "index.html?window=tools",
        "width": 720,
        "height": 420,
        "x": 980,
        "y": 560,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "autostart": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
