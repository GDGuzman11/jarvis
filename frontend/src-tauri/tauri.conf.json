{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helix",
  "version": "0.1.0",
  "identifier": "com.jarvis.hud",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "animation",
        "title": "Helix — Animation",
        "url": "index.html?window=animation",
        "width": 504,
        "height": 504,
        "x": 708,
        "y": 228,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "shutdown",
        "title": "Helix — Power",
        "url": "index.html?window=shutdown",
        "width": 52,
        "height": 52,
        "x": 1216,
        "y": 236,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "reasoning",
        "title": "Helix — Reasoning",
        "url": "index.html?window=reasoning",
        "width": 520,
        "height": 640,
        "x": 200,
        "y": 100,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "communications",
        "title": "Helix — Communications",
        "url": "index.html?window=communications",
        "width": 700,
        "height": 440,
        "x": 1180,
        "y": 80,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "agents",
        "title": "Helix — Agents",
        "url": "index.html?window=agents",
        "width": 870,
        "height": 280,
        "x": 200,
        "y": 760,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "tools",
        "title": "Helix — Tools",
        "url": "index.html?window=tools",
        "width": 700,
        "height": 460,
        "x": 1180,
        "y": 540,
        "decorations": false,
        "transparent": true,
        "resizable": true
      },
      {
        "label": "memory",
        "title": "Helix — Memory",
        "url": "index.html?window=memory",
        "width": 760,
        "height": 760,
        "x": 780,
        "y": 760,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "autostart": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
