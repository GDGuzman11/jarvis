# =============================================================================
# JARVIS — Environment Template (.env.example)
# =============================================================================
#
# THIS IS A TEMPLATE ONLY. DO NOT PUT REAL SECRETS IN THIS FILE OR IN A .env.
#
# Per the project Security Rules (CLAUDE.md, Rule 1 — "Zero secrets in files"):
# all REAL API keys and credentials live in the Windows Credential Manager and
# are accessed at runtime via the `keyring` library (see backend/security/
# keystore.py). This file exists purely to document WHICH credentials Jarvis
# expects and to give each one a stable, human-readable name.
#
# How real values are stored (NOT here):
#   - Use the keystore helpers in backend/security/keystore.py, OR
#   - Set them manually, e.g. in PowerShell:
#       python -c "import keyring; keyring.set_password('jarvis', 'ANTHROPIC_API_KEY', 'sk-ant-...')"
#
# The service name in Windows Credential Manager is `jarvis`; the username for
# each entry is the variable name shown below (e.g. ANTHROPIC_API_KEY).
#
# Replace every YOUR_*_HERE placeholder ONLY in your own private notes — never
# commit a populated copy of this file.
# =============================================================================


# -----------------------------------------------------------------------------
# Anthropic / Claude API  (primary AI — claude-opus-4-7, streaming + caching)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# Optional override; defaults are set in code.
ANTHROPIC_MODEL=claude-opus-4-7


# -----------------------------------------------------------------------------
# ElevenLabs  (text-to-speech — custom Tom Hardy x Jarvis voice)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE
# Voice ID of the custom profile you create in the ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID_HERE


# -----------------------------------------------------------------------------
# Slack  (Bolt integration — minimal scopes: chat:write, im:read, channels:read)
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN_HERE
SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN_HERE
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET_HERE


# -----------------------------------------------------------------------------
# Gmail  (OAuth 2.0 — minimal scopes: gmail.readonly + gmail.send)
# -----------------------------------------------------------------------------
# From the OAuth client you create at console.cloud.google.com.
GMAIL_CLIENT_ID=YOUR_GMAIL_CLIENT_ID_HERE
GMAIL_CLIENT_SECRET=YOUR_GMAIL_CLIENT_SECRET_HERE
# Must match an Authorized redirect URI on the OAuth client (local only).
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/oauth/gmail/callback
# Populated after the first OAuth consent flow; refreshed automatically.
GMAIL_REFRESH_TOKEN=YOUR_GMAIL_REFRESH_TOKEN_HERE


# -----------------------------------------------------------------------------
# Local services (non-secret defaults — safe to keep as-is)
# -----------------------------------------------------------------------------
# FastAPI binds local-only per Security Rule 2 — never 0.0.0.0.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
# Ollama local fallback (phi3.5 / qwen2.5-coder:3b).
OLLAMA_BASE_URL=http://127.0.0.1:11434
